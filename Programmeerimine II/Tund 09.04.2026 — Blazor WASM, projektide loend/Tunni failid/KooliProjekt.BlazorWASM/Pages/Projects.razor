@page "/projects"
@using KooliProjekt.ApiClient
@inject IProjectApiClient ApiClient

<PageTitle>Projects</PageTitle>

<h1>Projects</h1>

<p><a class="btn btn-primary" href="projects/new">Add project</a></p>

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}
else if (projects is null)
{
    <p><em>Loading projects...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr><th>Name</th><th>Start</th><th>Deadline</th><th>Budget</th><th>Current cost</th><th>Tasks</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var project in projects)
        {
            <tr>
                <td>@project.Name</td><td>@project.StartDate</td><td>@project.Deadline</td>
                <td>@project.Budget.ToString("C")</td><td>@project.CurrentCost.ToString("C")</td>
                <td>@project.CompletedTaskCount / @project.TaskCount</td>
                <td><a class="btn btn-sm btn-outline-primary" href="projects/@project.Id">Edit</a></td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<ProjectSummary>? projects;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await ApiClient.LoginAsync("demo@project.local", "Project123!");
            projects = (await ApiClient.ListProjectsAsync()).Results;
        }
        catch (Exception exception)
        {
            error = exception.Message;
        }
    }
}
