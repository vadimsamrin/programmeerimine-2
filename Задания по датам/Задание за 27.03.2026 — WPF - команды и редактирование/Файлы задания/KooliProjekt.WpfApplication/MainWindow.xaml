<Window x:Class="KooliProjekt.WpfApplication.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project management" Height="620" Width="1050" Loaded="Window_Loaded">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Load projects" Command="{Binding LoadCommand}" Padding="14,6" />
            <Button Content="New" Command="{Binding NewCommand}" Padding="14,6" Margin="8,0,0,0" />
            <TextBlock Text="{Binding Error}" Foreground="Firebrick" Margin="12,7,0,0" />
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DataGrid ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" AutoGenerateColumns="True"
                      IsReadOnly="True" CanUserAddRows="False" Margin="0,0,12,0" />
            <StackPanel Grid.Column="1">
                <TextBlock Text="Project editor" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                <TextBlock Text="Name" /><TextBox Text="{Binding EditingProject.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />
                <TextBlock Text="Start date (YYYY-MM-DD)" /><TextBox Text="{Binding EditingProject.StartDate}" Margin="0,2,0,8" />
                <TextBlock Text="Deadline (YYYY-MM-DD)" /><TextBox Text="{Binding EditingProject.Deadline}" Margin="0,2,0,8" />
                <TextBlock Text="Budget" /><TextBox Text="{Binding EditingProject.Budget}" Margin="0,2,0,8" />
                <TextBlock Text="Hourly rate" /><TextBox Text="{Binding EditingProject.HourlyRate}" Margin="0,2,0,8" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                    <Button Content="Save" Command="{Binding SaveCommand}" Padding="14,6" />
                    <Button Content="Delete" Command="{Binding DeleteCommand}" Padding="14,6" Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock Text="Current cost and completed tasks are shown in the grid." TextWrapping="Wrap" Foreground="DimGray" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
